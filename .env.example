# ============================================================
# PayGuard Switch — Environment Variables
# Copy this to .env and fill in values from Switch Console
# Setup: Switch Console (Cloud Switch) + Discord bridge
# ============================================================

# Switch Console API base URL
# Local:     http://localhost:8080
# Codespace: https://<codespace-name>-8080.preview.app.github.dev
SWITCH_URL=http://localhost:8080

# Room ID — Switch Console → Your Rooms → click your room → copy Room ID
SWITCH_ROOM_ID=PASTE_YOUR_ROOM_ID_HERE

# Discord messaging app name — exactly as shown in Switch Console → Messaging apps
SWITCH_MESSAGING_APP=playSwitch

# ── Agent Registration Keys ──────────────────────────────────────────────────
# Full Admin Interface → API Keys → New Key (type: registration)
# One key per agent. Used ONCE to register the agent via POST /agents.
SQL_AGENT_TOKEN=PASTE_SQL_FORENSICS_REGISTRATION_KEY_HERE
GATE_AGENT_TOKEN=PASTE_GATEKEEPER_REGISTRATION_KEY_HERE

# ── Agent IDs & API Keys (auto-filled on first run) ─────────────────────────
# These are set automatically when each agent registers for the first time.
# DO NOT fill these manually — the agent scripts write them after registration.
# SQL_AGENT_ID=
# SQL_AGENT_API_KEY=
# GATE_AGENT_ID=
# GATE_AGENT_API_KEY=
