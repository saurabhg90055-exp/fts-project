# ============================================================
# PayGuard Switch — Environment Variables
# Copy this to .env and fill in values from Switch Console
# Setup: Switch Console (Cloud Switch) + Discord bridge
# ============================================================

# Switch Console API — get from Switch Console → Full Admin Interface → API
# If running locally: http://localhost:8080
# If running via GitHub Codespace: https://<codespace-name>-8080.preview.app.github.dev
SWITCH_URL=http://localhost:8080

# Room ID — Switch Console → Your Rooms → click your room → copy the Room ID from URL or settings
# Example: room_abc123def456
SWITCH_ROOM_ID=PASTE_YOUR_ROOM_ID_HERE

# Discord messaging app name — exactly as shown in Switch Console → Messaging apps
# From your screenshot this is: playSwitch
SWITCH_MESSAGING_APP=playSwitch

# Agent tokens — Switch Console → Full Admin Interface → API Keys → New Key
# Create one token per agent; paste each below
SQL_AGENT_TOKEN=PASTE_SQL_FORENSICS_TOKEN_HERE
GATE_AGENT_TOKEN=PASTE_GATEKEEPER_TOKEN_HERE

